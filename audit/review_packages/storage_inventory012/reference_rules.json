  "namespace_rules": [
    {
      "id": "physical_prefix",
      "code": "quantconnect.ObjectStoreArtifactStore._key",
      "rule": "Physical SDK key is store.prefix + slash + validated relative key. Scope every reference to its originating physical prefix; never resolve a relative ref in another project/prefix by basename.",
      "known_fixed_prefixes": [
        "aqrp/engineering/v2",
        "aqrp/collection-tasks/v1"
      ],
      "other_prefixes": "Certification/other producers may use explicit frozen store_prefix. Unknown or non-AQRP prefixes are protected/unclassified, not owned garbage."
    },
    {
      "id": "cloud_locks",
      "code": "quantconnect.ObjectStoreArtifactStore.locked",
      "rule": "locks/... names select in-process RLock entries and do not call save_bytes. Do not invent physical reclaimable lock files from these strings. Unknown SDK lock/temp objects require their actual producer and object metadata."
    },
    {
      "id": "single_producer",
      "code": "quantconnect.ObjectStoreArtifactStore",
      "rule": "Process locks are not distributed CAS. Inventory consistency must reconcile every active/unknown producer; local absence of activity is not global orphan proof."
    }
  ],
  "reference_formats": [
    {
      "id": "feature_cache_v1_manifest",
      "relative_key": "feature-cache/v1/manifests/<DataRequest.key>.json",
      "key_digest_role": "Request identity digest, not manifest content SHA",
      "body_edges": [
        "payload -> exact relative feature-cache/v1/objects/<sha256>.json"
      ],
      "required_identity": [
        "dataset",
        "single field",
        "permanent SIDs",
        "calendar-year interval",
        "data_version",
        "universe_hash",
        "normalization",
        "timezone"
      ],
      "body_content_proof": "Manifest request must equal the field unit identity. Read raw payload bytes in QC Cloud and compare SHA256 to manifest.sha256; manifest rows/provenance/status alone do not prove bytes.",
      "retention": "All current and historical manifests plus reachable payloads protected."
    },
    {
      "id": "feature_cache_v1_payload",
      "relative_key": "feature-cache/v1/objects/<sha256>.json",
      "key_digest_role": "Expected SHA256 of exact serialized record-array bytes",
      "content": "One field per immutable object; rows carry SID,field,event_time,available_time,value,revision. Real rows remain QC Cloud. Do not use decoded/canonicalized data to claim raw-byte identity.",
      "dedup_note": "Content addressing already reuses an identical payload at one key; multiple references do not multiply storage. Different payload envelopes/values/revisions are not duplicates by field/year alone."
    },
    {
      "id": "feature_cache_intent_and_stream",
      "relative_keys": [
        "feature-cache/v1/intents/<DataRequest.key>.json",
        "cache"
      ],
      "key_digest_role": "Intent basename is request identity; cache is a hash-chained event stream, not a content-addressed payload.",
      "retention": "Protect fetched/fetch_failed event history and intents. Successful writes do not delete intents. An intent without a completed manifest blocks automatic refetch; it is not temporary garbage.",
      "failure_note": "A failed or interrupted fetch can already have written some field payloads/manifests before a later save failed. Failure status cannot establish that no objects or references exist."
    },
    {
      "id": "historical_snapshots_v1_v2_windows",
      "relative_keys": [
        "historical-snapshots/v1/windows/<identity_hash>.json",
        "historical-snapshots/v2/windows/<identity_hash>.json"
      ],
      "key_digest_role": "Window basename hashes {plan_hash,synthetic,window}; it is NOT SHA256 of the completed manifest body.",
      "body_edges": [
        "batches[*].key+sha256 -> same-version objects/<payload_sha256>.json",
        "plan_identity -> original complete plan and selected field catalog"
      ],
      "required_closure": "Verify canonical manifest bytes by reference SHA, exact version/plan/window/synthetic/flags, all ordered batches, all rows and declared counts/missing/occurrence counters against the ORIGINAL plan.",
      "retention": "All complete historical window manifests and their closure protected, including empty complete windows."
    },
    {
      "id": "historical_snapshots_batches",
      "relative_keys": [
        "historical-snapshots/v1/objects/<payload_sha256>.json",
        "historical-snapshots/v2/objects/<payload_sha256>.json"
      ],
      "key_digest_role": "Expected exact canonical-JSON payload SHA, verified by actual bytes; not inferred from name.",
      "content_identity": [
        "schema_version",
        "plan_hash",
        "synthetic",
        "window",
        "batch_index",
        "records"
      ],
      "dedup_note": "Identical projected row values under different plans/windows/batch indexes/source occurrences can have different legitimate payloads. v2 preserves duplicate source_record_index occurrences; never remove duplicate SIDs or collapse the 27 observed duplicate projections as storage garbage."
    },
    {
      "id": "historical_snapshot_intents",
      "relative_keys": [
        "historical-snapshots/v1/intents/<identity_hash>.json",
        "historical-snapshots/v2/intents/<identity_hash>.json"
      ],
      "key_digest_role": "Same logical window-identity basename as windows, different body and folder; not a byte duplicate.",
      "retention": "Protect source-request reservations, incomplete intents and related partial batches/failure evidence. No age, failed attempt, empty day or presence of a later completed window alone authorizes removal."
    },
    {
      "id": "engineering_reports_and_resolution",
      "relative_patterns": [
        "<report_namespace>/reports/<plan_hash>/<stage>/<attempt>.json",
        "<report_namespace>/resolutions/<plan_hash>/<content_hash>.json",
        "<report_namespace>/collection-probes/<plan_hash>/<attempt>.json",
        "<collection_report_namespace>/receipts/<attempt>.json"
      ],
      "key_digest_role": "Reports/receipts identify plan and attempt, not content; _save returns a separate SHA256 of exact canonical document bytes.",
      "body_edges": [
        "resolved_registry_ref",
        "resolved_request_ref",
        "coverage_report_ref",
        "cache_payload_refs",
        "collection_probe.receipt_ref",
        "collection_storage.origin_receipt_ref",
        "received_bar_ref",
        "corporate_action_ref",
        "collection first/cache_only_replay.window_refs"
      ],
      "retention": "Protect success, failure, repair, admitted provenance and original receipt identities; preserve all transitive references from every historical version, not just current mutable pointers."
    },
    {
      "id": "coverage_evidence_and_snapshot",
      "relative_patterns": [
        "audit-evidence/<content_hash>.json",
        "coverage-inputs/v1/<snapshot_content_hash>.json",
        "coverage-inputs/v1/provenance/<content_hash>.json"
      ],
      "body_edges": [
        "report.raw_snapshot_ref",
        "report.source_payload_refs[*]",
        "report.provenance_ref"
      ],
      "dedup_note": "A coverage row wrapper can overlap cached rows but has different bytes/identity and audit purpose. Schema4 snapshot_cache_only explicitly requires the old exact full snapshot to exist; deleting it because the field cache also exists breaks the pipeline.",
      "retention": "All historical coverage manifests, raw snapshots, provenance and their field payload closure protected."
    },
    {
      "id": "received_cached_row_reference_v1",
      "relative_pattern": "<report_namespace>/received/<attempt>/<manifest_sha256>.json",
      "key_digest_role": "manifest_sha256 is SHA256 of exact reference-manifest JSON bytes; actual/cached rowset SHA is a DIFFERENT digest domain.",
      "body_edges": [
        "source_refs[*] -> exactly5 original feature-cache/v1/objects/<sha>.json"
      ],
      "required_identity": [
        "request_hash",
        "window",
        "record_count",
        "actual_rowset_sha256",
        "cached_rowset_sha256",
        "row_values_stored=false"
      ],
      "required_closure": "Original5 field payloads must be verified and the exact frozen-window received/cache rowsets equal. The received manifest stores references and hashes rather than new row objects.",
      "retention": "Protect the manifest AND all5 source payloads. A small reference object does not make its large referenced cache data releasable."
    },
    {
      "id": "received_legacy_JSON",
      "relative_pattern": "<report_namespace>/received/<attempt>/<content_hash>.json",
      "content": "Older schema1/2 stores rows wrapper and separate corporate actions as full canonical JSON.",
      "dedup_note": "Values may overlap other caches, but whole raw-byte equality and frozen metadata compatibility are separate proofs. Keep all historical received evidence and row/action closure."
    },
    {
      "id": "received_retired_zlib",
      "relative_pattern": "<report_namespace>/received/<attempt>/<stored_sha256>.zlib",
      "version_source": "f1713b86b3aa802368d21a8f48eb77a7657702e3",
      "hash_domains": {
        "stored_sha256": "SHA256 of compressed object bytes",
        "raw_sha256": "SHA256 of uncompressed canonical JSON; NOT the stored-file SHA"
      },
      "required_verification": [
        "actual compressed size and stored SHA",
        "bounded historical decoder with no extra tail data",
        "uncompressed size and raw SHA",
        "canonical JSON and declared original identity"
      ],
      "retention": "Retired runtime/schema does not make existing objects garbage. No real decoding was performed in this audit; preserve historical metadata and compressed objects until separately authorized verified migration."
    },
    {
      "id": "ingestion_and_certification",
      "relative_patterns": [
        "ingestion/v1/batches/<content_hash>.json",
        "ingestion/v1/index/<namespace>/<kind>/<partition>.jsonl",
        "data-certification/v1/inputs/<content_hash>.json",
        "data-certification/v1/contexts/<content_hash>.json",
        "data-certification/v1/reports/<content_hash>.json"
      ],
      "body_edges": [
        "index event.batch_key/batch_hash",
        "report.evidence_refs[*]",
        "report.context_ref",
        "summary.report_refs[*]"
      ],
      "retention": "Protect ingestor source binding, source revisions/vintages, index event history, certification context/plan and all supporting batches/tables. A partition or vintage identity digest is not a raw object SHA."
    }
  ],
  "verified_legacy_linkage": {
    "required_metadata": [
      "storage_policy.collection_cache.legacy.plan_identity",
      "plan_hash",
      "source_manifest_hash",
      "processing_contract_sha256",
      "receipt_ref",
      "receipt_identity"
    ],
    "required_proof": "Match requested and original data_identity under the SAME admitted processing contract, verify original receipt canonical bytes+SHA+attempt identity, then verify every completed original window and batch and both first/cache-only replay summaries. No missing object may fall through to new fetch or relabeling.",
    "stable_identity_semantics": "data_identity excludes only research plan_id and deployment/source_manifest_hash from collection semantics; it still binds processing contract, data_version, fields/catalog, interval/timezone, window/batch bounds and observation policy. stable_collection_plan derives a deterministic data-cache plan from that identity.",
    "current_vs_historical_contract": "Current closure includes financial_fields.py; old5e09 four-source processing contract5ef61ef75f80ee7de0abcfd5461896a427a20d4c621d10759855b4cd11468219 remains historical. historical_decode can preserve old identity, but it does not grant current cache compatibility or permit old-cache removal.",
    "protection_rule": "An old payload referenced only through a legacy receipt is still live for audit/replay. Protect legacy receipt -> both window_ref lists -> all old version manifests -> all batches; do not inspect only latest requested plan or stable namespace."
  },
  "conservative_candidate_rules": [
    "Inventory must be complete across every page/cursor and relevant organization prefix, with unique keys, authoritative byte lengths, observation time, and consistent repeated listing. An incomplete/truncated/erroring list cannot prove unreferenced objects.",
    "Identify every actual producer/consumer and every current/historical/frozen manifest, receipt, admitted input, report, coverage object, index/event stream, unresolved intent, failure/repair record and legacy linkage as roots. Close all explicit and schema-derived edges transitively. Unknown schema, ambiguous reference scope, cross-project consumer or absent metadata is protected/unclassified.",
    "All historical manifests/receipts, event streams, intents and their required closures are protected under this inventory. Failed/retired status, age or a later similarly named object is not a deletion predicate.",
    "Potential non-authoritative duplicates require actual QC-resident byte hashing and complete metadata identity comparison; filename hashes, ETag/version tokens, reported SHA fields, same size, same year/SID or same rowset alone are not raw-original proof.",
    "Before even proposing a payload as reclaimable, prove it is outside all protected/current/historical closure and unresolved work, that ownership permits review, and that an independently verified retained QC-resident copy and evidence chain satisfy retention and recovery requirements. Immutable historical keys may not be silently redirected or rewritten.",
    "Byte-equal copies at different physical keys can still be required by immutable references; sharing one key among many manifests is already deduplicated. Semantic duplicates with different availability, revision, original occurrence or serialization stay distinct unless an explicitly reviewed migration preserves every original obligation.",
    "Current metadata-only/readonly inventory cannot delete or claim confirmed released bytes. Unverified object bytes or incomplete reference closure must never enter confirmed-release sums; any potential-byte total must be labelled conditional and avoid counting shared payloads more than once.",
    "Any future removal needs a separate concrete user-approved manifest and fresh pre-delete inventory/closure checks. This task grants no deletion, refetch, source/config change, new Research/backtest, quota reset, purchase or final-period access."
  ],
  "hash_domain_rules": [
    "Distinguish key identity digest, actual object raw-byte SHA, canonical JSON digest, source_manifest text identity, semantic processing contract, decoded rowset digest and event envelope hash. Never use one as another.",
    "Feature-cache manifests/intents and historical window manifests/intents are identity-keyed, not generally content-named. Engineering attempt reports/receipts are also identity-keyed. Their actual content requires its own verified raw SHA.",
    "Even for content-named objects, basename is only an assertion until bytes are hashed in QC Cloud. Do not export real payloads or row-derived values to Git/local disk for this comparison.",
    "Event envelope hashes authenticate only the canonical unsigned envelope chain inside the artifact; whole stream raw SHA changes after append. It is not a payload-object digest or externally signed/tamperproof provenance."
  ],
  "side_effect_limits": {
    "metadata_listing": "Prefer actual platform metadata endpoints. If using SDK get_file_path, only pass existing keys from a complete observed listing; never guessed missing keys. SDK can flush its existing dirty cache internally, so zero explicit save/delete does not establish absence of every SDK-internal effect.",
    "real_data_residency": "Any future payload validation stays QC Cloud and exports only permitted counts/hashes/metadata. No real rows were read in this code audit.",
    "retention_priority": "When completeness, ownership, raw bytes or reference status is unknown, protect first and report evidence insufficient."
  },
