    {
      "id": "WR-07",
      "priority": "P2",
      "status": "open",
      "source_commit": "fe4374cee054fb8053706074be913ad7068c4484",
      "title": "默认Pearson及绝对Pearson矩阵对合法有限分数产生尺度相关错误",
      "locations": [
        {
          "file": "cloud/qresearch/evaluation.py",
          "lines": [
            210,
            212,
            250,
            258,
            259,
            262,
            270,
            271,
            272
          ]
        }
      ],
      "trigger": "x=[s,2s,3s]，y=[1,2,3]；s为1e-200或1e200。调用公共paired_factor_correlation默认方法或pairwise_factor_correlations的absolute_pearson。",
      "expected": {
        "correlation": 1.0,
        "absolute_correlation": 1.0
      },
      "actual": {
        "s_1e_minus_200": {
          "correlation": null,
          "absolute_correlation": null,
          "representation": "NaN"
        },
        "s_1e200": {
          "correlation": 0.0,
          "absolute_correlation": 0.0
        },
        "normal_scale": 1.0,
        "fixed_spearman_same_inputs": 1.0
      },
      "cause": "Pearson分支仍使用原值np.std和np.corrcoef；平方下溢误判常数，大尺度方差溢出使交叉相关被报告为0。",
      "impact": "完全冗余的有限因子分数可被报告为零绝对相关或未定义，影响已实现的相关性比较。完整搜索未验收，本轮未观察或宣称真实市场选择损失。",
      "severity_reason": "已接受有限输入的实际数值错误，属于继承的极端尺度边界；并非本次Spearman修复新引入。",
      "baseline_75_also_reproduced": true,
      "minimal_reproduction": "numeric_agent/minimal_pearson.py source；新旧SHA均在独立进程运行，root_confirmed_wr07.json另存主审核复核。",
      "minimal_fix": "使用避免上下溢的居中、缩放、协方差和范数算法；常数判断不能依赖会下溢的原值方差。保留共同有限样本、符号和缺失合同。",
      "required_regressions": [
        "默认paired Pearson与absolute_pearson矩阵在1e-200/1/1e200下不变",
        "正负线性关系及非完美相关的独立手算",
        "常数、缺失、共同样本和最小样本数",
        "不得仅将默认方法改为Spearman代替Pearson正确实现"
      ],
      "evidence_level": "reviewer_executed_independent_synthetic_tests"
    }
  ],
